library(shiny)
library(ggplot2)
df <- data.frame(
x = c(40, 50, 60, 70, 80),
y = c(220, 260, 310, 350, 410)
)
fit <- lm(y ~ x, data = df)
r2 <- round(summary(fit)$r.squared, 2)
mse <- round(mean(residuals(fit)^2), 0)
df$label <- paste0("(", df$x, ", ", df$y, ")")
inputPanel(
checkboxInput("show_line", "Mostrar Reta OLS", value = TRUE),
checkboxInput("show_labels", "Mostrar Pares Ordenados", value = TRUE),
checkboxInput("show_metrics", "Mostrar Métricas (R² e MSE)", value = TRUE)
)
renderPlot({
p <- ggplot(df, aes(x = x, y = y)) +
geom_point(color = "blue", size = 4) +
scale_x_continuous(limits = c(30, 90), breaks = seq(30, 90, 10)) +
scale_y_continuous(limits = c(200, 450), breaks = seq(200, 450, 50)) +
labs(
title = "Linear Regression Visualizer",
x = "X",
y = "y"
) +
theme_bw(base_size = 14) +
theme(
plot.title = element_text(hjust = 0.5, size = 18, face = "plain"),
panel.grid.major = element_line(color = "gray80"),
panel.grid.minor = element_blank()
)
if (input$show_line) {
p <- p + geom_smooth(method = "lm", se = FALSE, color = "red", size = 1.2, fullrange = TRUE)
}
if (input$show_labels) {
p <- p + geom_text(
aes(label = label),
vjust = -1.2,
hjust = 0.5,
size = 5,
fontface = "bold",
color = "black"
)
}
if (input$show_metrics) {
p <- p + annotate(
"label",
x = 88,
y = 210,
label = paste0("R² = ", r2, "\nMSE = ", mse),
hjust = 1,
vjust = 0,
size = 4.5,
fill = "white",
color = "black"
)
}
p
}, height = 450)
