import numpy as npfrom sklearn.linear_model
import LinearRegression
X = np.array([[40], [50], [60], [70], [80]])
y = np.array([220, 260, 310, 350, 410])
modelo = LinearRegression()modelo.fit(X, y)
print("O valor de W é: ",modelo.coef_)
print(f"Qunado X vale 65, a saida vale: {modelo.predict([[65]])}")
print(f"O valor de b é {modelo.intercept_}")
import numpy as np
from sklearn.linear_model
import LinearRegression
X = np.array([[40], [50], [60], [70], [80]])
y = np.array([220, 260, 310, 350, 410])
# Crie o seu modelo
modelo = LinearRegression()
# Treine o seu modelo (ajuste sua reta aos pontos)
modelo.fit(X, y)
print("O valor de W é: ",modelo.coef_)
print(f"Qunado X vale 65, a saida vale: {modelo.predict([[65]])}")
print(f"O valor de b é {modelo.intercept_}")
import numpy as np
from sklearn.linear_model import LinearRegression
X = np.array([[40], [50], [60], [70], [80]])
y = np.array([220, 260, 310, 350, 410])
# Crie o seu modelo
modelo = LinearRegression()
# Treine o seu modelo (ajuste sua reta aos pontos)
modelo.fit(X, y)
print("O valor de W é: ",modelo.coef_)
print(f"Qunado X vale 65, a saida vale: {modelo.predict([[65]])}")
print(f"O valor de b é {modelo.intercept_}")
library(ggplot2)
# 1. Definir os dados
df <- data.frame(
x = c(40, 50, 60, 65, 70, 80),
y = c(220, 260, 310, 333.5, 350, 410)
)
# 2. Ajustar o modelo OLS e calcular métricas
fit <- lm(y ~ x, data = df)
r2 <- round(summary(fit)$r.squared, 2)
mse <- round(mean(residuals(fit)^2), 0)
# 3. Formatar rótulos dos pares ordenados "(x, y)"
df$label <- paste0("(", df$x, ", ", df$y, ")")
# 4. Gerar o gráfico
ggplot(df, aes(x = x, y = y)) +
# Linha de Regressão Linear (vermelha)
geom_smooth(method = "lm", se = FALSE, color = "red", size = 1.2, fullrange = TRUE) +
# Pontos Reais (azuis)
geom_point(color = "blue", size = 4) +
# Rótulos dos pares ordenados acima dos pontos
geom_text(
aes(label = label),
vjust = -1.2,
hjust = 0.5,
size = 4.5,
fontface = "bold",
color = "black"
) +
# Caixa de métricas (R² e MSE) no canto inferior direito
annotate(
"label",
x = 88,
y = 210,
label = paste0("R² = ", r2, "\nMSE = ", mse),
hjust = 1,
vjust = 0,
size = 4,
fill = "white",
color = "black"
) +
# Ajustes de Eixos e Limites
scale_x_continuous(limits = c(30, 90), breaks = seq(30, 90, 5)) +
scale_y_continuous(limits = c(200, 450), breaks = seq(200, 450, 10)) +
# Títulos e Rótulos
labs(
title = "Regressão Linear - y = w(x) + b ",
x = "entrada X - Metragem Apartamento - Variável independente",
y = "Saída Y - Valor do imóvel em R$ - Variável dependente"
) +
# Tema visual equivalente ao da imagem
theme_bw(base_size = 14) +
theme(
plot.title = element_text(hjust = 0.5, size = 18, face = "plain"),
panel.grid.major = element_line(color = "gray80"),
panel.grid.minor = element_blank()
)
